# Copy to deploy/config.env and fill in. Never commit deploy/config.env.
# The key can also come from the environment; this file is for convenience.

# --- chain selection ----------------------------------------------------
# sepolia       = Ethereum Sepolia, chain id 11155111 (default)
# base-sepolia  = Base Sepolia, chain id 84532
ORIGIN_CHAIN=sepolia

# --- RPCs ---------------------------------------------------------------
# Leave RPC_ORIGIN empty to use the default for ORIGIN_CHAIN:
#   sepolia       https://ethereum-sepolia-rpc.publicnode.com
#   base-sepolia  https://sepolia.base.org
RPC_ORIGIN=
RPC_LASNA=https://lasna-rpc.rnk.dev/

# --- auth ---------------------------------------------------------------
# Use exactly one of:
# PRIVATE_KEY=0x...
# ACCOUNT=my-foundry-keystore
OWNER=

# --- protocol constants (derived from ORIGIN_CHAIN if left empty) -------
# sepolia       chain 11155111, proxy 0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4
# base-sepolia  chain 84532,    proxy 0x476F44b11F5C942c58f4c8E3d0300E5710743585
ORIGIN_CHAIN_ID=
DEST_CHAIN_ID=
CALLBACK_PROXY=
SYSTEM=0x8888888888888888888888888888888888888888
EXPLORER=

# Official Reactive faucet: send ETH with request(address), 1 ETH = 100 lREACT.
# sepolia       0x9b9BB25f1A81078C544C829c5EB7822d747Cf434
# base-sepolia  0x2afaFD298b23b62760711756088F75B7409f5967
REACTIVE_FAUCET=

# --- funding ------------------------------------------------------------
# lREACT credited to the reactive contract (covers reactive transactions)
FUND_REACT=0.2ether
# Origin-chain ETH credited to the vault (covers callback fees)
FUND_ETH=0.005ether
