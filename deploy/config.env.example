# Copy to deploy/config.env and fill in. Never commit deploy/config.env.
# The key can also come from the environment; this file is for convenience.

# --- RPCs ---------------------------------------------------------------
RPC_BASE=https://sepolia.base.org
RPC_LASNA=https://lasna-rpc.rnk.dev/

# --- auth ---------------------------------------------------------------
# Use exactly one of:
# PRIVATE_KEY=0x...
# ACCOUNT=my-foundry-keystore
OWNER=

# --- protocol constants (Base Sepolia <-> Reactive Lasna) ---------------
ORIGIN_CHAIN_ID=84532
DEST_CHAIN_ID=84532
CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
SYSTEM=0x8888888888888888888888888888888888888888

# --- funding ------------------------------------------------------------
# lREACT credited to the reactive contract (covers reactive transactions)
FUND_REACT=0.2ether
# Base Sepolia ETH credited to the vault (covers callback fees)
FUND_ETH=0.005ether
